# ==============================================================================
# Environment Configuration Template
# Copy this file to '.env' and populate with your credentials.
# ==============================================================================

# Google Gemini API Key (Required for live LLM generation)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# ThingSpeak IoT Channel Configuration (Optional: mock data used if omitted)
THINGSPEAK_CHANNEL_ID=your_thingspeak_channel_id_here
THINGSPEAK_READ_API_KEY=your_thingspeak_read_api_key_here

# Hugging Face Token (Optional: only needed for private HF models/datasets)
HF_TOKEN=

# Application Server Settings
PORT=7860
HOST=127.0.0.1
